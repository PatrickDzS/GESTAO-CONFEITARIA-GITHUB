# ============================================================
# VARIÁVEIS DE AMBIENTE — copie para .env e preencha com seus dados
#
# O Vite embute estas variáveis no JavaScript NO MOMENTO DO BUILD.
# Por isso elas precisam existir na Vercel (Settings > Environment
# Variables) ANTES de cada novo deploy — o arquivo .env local NÃO
# sobe para o Git (está no .gitignore) e não é lido pela Vercel.
# ============================================================

# URL do projeto Supabase (Settings > API > Project URL)
# Sem barra no final. Ex.: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://kdeqpsomfmpbygwrowoc.supabase.co
# Chave pública "anon" (Settings > API > anon / publishable key)
# Começa com eyJ...  (JWT) ou com sb_publishable_...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtkZXFwc29tZm1wYnlnd3Jvd29jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxOTg5ODAsImV4cCI6MjEwNTc3NDk4MH0.ucsHaCBiWadXl8a3qrpxGeZsnZtGGHX9Srau1eJdQmI
